{
  "name": "wibbly-io",
  "private": true,
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_WIBBLY_MODE=demo vite",
    "build": "vite build",
    "build:demo": "VITE_WIBBLY_MODE=demo WIBBLY_BASE=/products/wibbly/play/ WIBBLY_OUTDIR=dist-demo vite build",
    "preview": "vite preview",
    "screenshots": "node scripts/screenshots.mjs",
    "verify:model": "node scripts/verify-model.mjs",
    "verify:demo": "node scripts/verify-demo.mjs",
    "test": "npm run test --workspace @vulos/wibbly-input && npm run test --workspace @vulos/wibbly-magnetite && npm run test:app",
    "test:app": "vitest run --config vitest.config.js",
    "typecheck": "npm run typecheck --workspace @vulos/wibbly-input && npm run typecheck --workspace @vulos/wibbly-magnetite"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@vulos/wibbly-input": "*",
    "@vulos/wibbly-magnetite": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.3",
    "three": "^0.174.0"
  }
}
